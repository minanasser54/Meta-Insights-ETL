METAETL_DATABASE_BACKEND=sqlite
METAETL_SQLITE_PATH=metaetl.sqlite3
METAETL_USER_TOKEN=
METAETL_PAGE_ACCESS_TOKEN=
METAETL_API_VERSION=v25.0
METAETL_TOKEN_SOURCE=env
METAETL_TOKEN_QUERY=
METAETL_SQL_SERVER=
METAETL_SQL_DATABASE=DataWarehouse
METAETL_SQL_SCHEMA=STG.Marketing
METAETL_SQL_DRIVER=ODBC Driver 18 for SQL Server
METAETL_SQL_USE_WINDOWS_AUTH=true
METAETL_SQL_USERNAME=
METAETL_SQL_PASSWORD=
METAETL_SQL_ENCRYPT=no
METAETL_LOG_DIRECTORY=logs
METAETL_LOG_LEVEL=INFO
METAETL_POST_INSIGHTS_MODE=recent
METAETL_POST_INSIGHTS_LIMIT=1000
